# ---- Database ----
DB_USER=postgres
DB_HOST=localhost
DB_NAME=dental_clinic
DB_PASSWORD=change-me
DB_PORT=5432
DB_POOL_SIZE=10

# ---- Server ----
PORT=5001
NODE_ENV=development

# ---- Security ----
# Generate a strong random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# Comma-separated list of allowed client origins
CORS_ORIGIN=http://localhost:5173

# ---- Client (Vite) ----
VITE_API_URL=http://localhost:5001
